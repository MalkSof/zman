{
  "manifest_version": 3,
  "name": "zman",
  "version": "0.2.0",
  "description": "Tells the zman time tracker on this computer which site the active tab is on, and blocks the sites you asked zman to block. Nothing leaves your machine.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "zman",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zman@malksof.github.io",
      "strict_min_version": "121.0"
    }
  }
}
